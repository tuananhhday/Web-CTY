# =============================================================================
# BIẾN MÔI TRƯỜNG — FILE MẪU
# =============================================================================
# Sao chép thành .env rồi điền giá trị thật:   cp .env.example .env
#
# QUY TẮC:
#   - KHÔNG commit file .env chứa giá trị thật.
#   - Biến có tiền tố NEXT_PUBLIC_ sẽ lộ ra trình duyệt — tuyệt đối không đặt secret.
#   - Giá trị trong file này là placeholder an toàn, không phải secret thật.
#   - Ứng dụng validate toàn bộ biến khi khởi động (src/lib/env.ts) và dừng nếu thiếu.
# =============================================================================

# --- Môi trường ---------------------------------------------------------------
NODE_ENV="development"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- PostgreSQL (docker-compose) ----------------------------------------------
# Các biến POSTGRES_* được docker-compose.yml đọc để tạo container.
POSTGRES_USER="vantai"
POSTGRES_PASSWORD="vantai_local_dev"
POSTGRES_DB="vantai"
POSTGRES_PORT="5433"

# Chuỗi kết nối Prisma dùng. Cổng phải khớp POSTGRES_PORT ở trên.
DATABASE_URL="postgresql://vantai:vantai_local_dev@localhost:5433/vantai?schema=public"

# --- Xác thực (Better Auth) ---------------------------------------------------
# Sinh chuỗi ngẫu nhiên:  openssl rand -base64 32
# Mỗi môi trường dùng một giá trị khác nhau. Không tái sử dụng giữa dev và production.
BETTER_AUTH_SECRET="thay-bang-chuoi-ngau-nhien-toi-thieu-32-ky-tu"
BETTER_AUTH_URL="http://localhost:3000"

# Bật MFA bắt buộc cho tài khoản nhân viên quyền cao (§9).
REQUIRE_STAFF_MFA="false"

# --- Tài khoản seed cho development (§33) -------------------------------------
# CHỈ dùng ở máy local. Không đặt các biến này trên production.
SEED_ADMIN_EMAIL="superadmin@local.test"
SEED_ADMIN_PASSWORD="ThayDoiMatKhauNay123!"
SEED_DEMO_PASSWORD="ThayDoiMatKhauNay123!"

# --- Object storage: S3-compatible / Cloudflare R2 (§16) ----------------------
# Để trống STORAGE_PROVIDER="local" thì hệ thống dùng adapter lưu file trên đĩa,
# chỉ phục vụ development, KHÔNG dùng cho production.
STORAGE_PROVIDER="local"
STORAGE_BUCKET="vantai-media"
STORAGE_REGION="auto"
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
# Thời hạn presigned URL, tính bằng giây. Giữ ngắn (§16.3).
STORAGE_SIGNED_URL_TTL="300"

# --- Bản đồ (§17) -------------------------------------------------------------
# Chưa có key thì đặt "none": giao diện sẽ hiển thị địa chỉ dạng văn bản thay bản đồ.
MAP_PROVIDER="none"
# Key này lộ ra client — bắt buộc giới hạn theo HTTP referrer trong console nhà cung cấp.
NEXT_PUBLIC_MAP_API_KEY=""
GEOCODING_PROVIDER="none"
GEOCODING_API_KEY=""

# --- Email (§21) --------------------------------------------------------------
# "console" = in email ra terminal, dùng cho development.
EMAIL_PROVIDER="console"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="Nen tang van tai <no-reply@example.test>"

# --- SMS / Zalo (§21) ---------------------------------------------------------
SMS_PROVIDER="console"
SMS_API_KEY=""
SMS_SENDER_ID=""
ZALO_PROVIDER="none"
ZALO_OA_ID=""
ZALO_ACCESS_TOKEN=""

# --- Redis (§4, tuỳ chọn) -----------------------------------------------------
# "memory" = rate limit trong bộ nhớ tiến trình, chỉ đúng khi chạy 1 instance.
# Production nhiều instance phải chuyển sang "redis".
RATE_LIMIT_DRIVER="memory"
REDIS_URL=""
REDIS_PORT="6380"

# --- Quét mã độc file tải lên (§16.3) -----------------------------------------
# "noop" = bỏ qua bước quét. Chỉ chấp nhận ở development.
VIRUS_SCAN_PROVIDER="noop"
VIRUS_SCAN_ENDPOINT=""
VIRUS_SCAN_API_KEY=""

# --- CAPTCHA cho form public (§30.1) ------------------------------------------
CAPTCHA_PROVIDER="none"
NEXT_PUBLIC_CAPTCHA_SITE_KEY=""
CAPTCHA_SECRET_KEY=""

# --- Giám sát lỗi (§32.3) -----------------------------------------------------
ERROR_MONITORING_DSN=""
LOG_LEVEL="debug"

# --- Chính sách dữ liệu (§17, §31) --------------------------------------------
# Số ngày giữ LocationPing chi tiết trước khi làm mờ/xoá.
LOCATION_RETENTION_DAYS="30"
# Số phút sau khi chuyến kết thúc mà khách còn xem được vị trí.
LOCATION_VISIBILITY_MINUTES="60"
# Số ngày giữ AuditLog.
AUDIT_RETENTION_DAYS="365"

# ---------------------------------------------------------------------------
# Bộ lập lịch job định kỳ (§25)
# ---------------------------------------------------------------------------
# true  = ứng dụng tự chạy outbox, dọn vị trí quá hạn và dọn media bỏ dở.
#         CHỈ bật khi triển khai MỘT tiến trình duy nhất (một VPS, một container).
# false = không tự chạy. Gọi POST /api/internal/scheduler/run từ cron bên ngoài.
#         Bắt buộc dùng cách này khi chạy nhiều instance hoặc trên nền serverless,
#         nếu không mỗi instance sẽ chạy job riêng và nhân đôi công việc.
# Chi tiết: docs/operations-runbook.md
SCHEDULER_ENABLED="false"

# Database tạm cho Prisma migrate diff/dev (chỉ dùng ở development)
SHADOW_DATABASE_URL="postgresql://vantai:vantai_local_dev@localhost:5433/vantai_shadow?schema=public"
