# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
/.claude/
/.vscode/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — không bao giờ commit giá trị thật
.env*
# .env.example chỉ chứa tên biến và placeholder an toàn nên cần được commit
!.env.example

# file upload local của StorageProvider adapter "local" (chỉ dùng ở development)
/storage/

# kết quả test
/test-results/
/playwright-report/
/coverage/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Prisma Client sinh tự động (prisma generate)
/src/generated/
